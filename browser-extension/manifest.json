{
  "manifest_version": 3,
  "name": "VideoKey Studio",
  "version": "1.0",
  "description": "Відкриває VideoKey Studio, а якщо вона вимкнена, запускає її на цьому Mac.",
  "key": "",
  "action": {"default_title": "Відкрити VideoKey Studio", "default_icon": {"16": "icon16.png", "48": "icon48.png", "128": "icon128.png"}},
  "icons": {"16": "icon16.png", "48": "icon48.png", "128": "icon128.png"},
  "background": {"service_worker": "background.js"},
  "permissions": ["nativeMessaging", "tabs"],
  "host_permissions": ["http://127.0.0.1:8770/*"]
}
